# Google Maps Platform Key
GOOGLE_MAPS_PLATFORM_KEY=

# SMS Gateway Config (MarketBuzzer Teleservices Pvt Ltd - Service Implicit 'serv_imp' Route)
# SMS_KEY: Authkey / API Key for MarketBuzzer Teleservices
SMS_KEY=rJCIC6J0
# SMS_PASSWORD: User password or secret for MarketBuzzer API authentication
SMS_PASSWORD=mXdYj5Bc
# SMS_ACCOUNT_TYPE: 'serv_imp' (Service Implicit transactional route)
SMS_ACCOUNT_TYPE=serv_imp
# SMS_SENDER_ID: Exactly 6 alphabetic characters registered on DLT (e.g. LKLBND)
SMS_SENDER_ID=LKLBND
# SMS_MATCH_TEMPLATE: 'false' for direct message dispatch, or 'true' when strict DLT registered template is enforced
SMS_MATCH_TEMPLATE=false
# SMS_TEMPLATE_ID: Optional DLT template ID (e.g., 1207161541234567890)
SMS_TEMPLATE_ID=
MARKETBUZZER_AUTHKEY=
MARKETBUZZER_TEMPLATE_ID=

# OTP Policy Configuration
SMS_OTP_LENGTH=4
SMS_OTP_EXPIRY=10

# Firebase Configuration
FIREBASE_API_KEY=

# Custom Domain (e.g. localbandimultiservices.in)
CUSTOM_DOMAIN=localbandimultiservices.in
