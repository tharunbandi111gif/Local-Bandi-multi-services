# Google Maps Platform Key
GOOGLE_MAPS_PLATFORM_KEY=

# SMS Gateway Config (Service Implicit 'serv_imp' & MSG91 Routes)
# SMS_KEY: Authkey / API Key for the Service Implicit gateway (MSG91 / BulkSMSGateway)
SMS_KEY=rJCIC6J0
# SMS_PASSWORD: User password or secret for API authentication
SMS_PASSWORD=mXdYj5Bc
# SMS_ACCOUNT_TYPE: 'serv_imp' (Service Implicit transactional route) or '4' (Transactional)
SMS_ACCOUNT_TYPE=serv_imp
# SMS_SENDER_ID: Exactly 6 alphabetic characters registered on DLT (e.g. LKLBND)
SMS_SENDER_ID=LKLBND
# SMS_MATCH_TEMPLATE: 'false' for direct text, or 'true' when strict DLT registered template is enforced
SMS_MATCH_TEMPLATE=false
# SMS_TEMPLATE_ID / MSG91_TEMPLATE_ID: Optional DLT template ID (e.g., 1207161541234567890)
SMS_TEMPLATE_ID=
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# OTP Policy Configuration
SMS_OTP_LENGTH=4
SMS_OTP_EXPIRY=10

# Firebase Configuration
FIREBASE_API_KEY=

# Custom Domain (e.g. localbandimultiservices.in)
CUSTOM_DOMAIN=localbandimultiservices.in
