{
  "entities": {
    "MarriageProfile": {
      "title": "MarriageProfile",
      "description": "A profile in the marriage bureau.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "surname": { "type": "string" },
        "age": { "type": "string" },
        "dob": { "type": "string" },
        "height": { "type": "string" },
        "skinTone": { "type": "string", "enum": ["Fair", "Complexion", "Wheatish", "Other"] },
        "education": { "type": "string" },
        "profession": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "siblings": { "type": "string" },
        "siblingsStatus": { "type": "string" },
        "fatherName": { "type": "string" },
        "fatherProfession": { "type": "string" },
        "motherName": { "type": "string" },
        "motherProfession": { "type": "string" },
        "gothram": { "type": "string" },
        "star": { "type": "string" },
        "raasi": { "type": "string" },
        "nativePlace": { "type": "string" },
        "about": { "type": "string" },
        "image": { "type": "string" },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "religion": { "type": "string" },
        "caste": { "type": "string" },
        "maritalStatus": { "type": "string", "enum": ["Unmarried", "Married", "Divorced", "Widow", "Widower", "3rd Marriage"] },
        "isApproved": { "type": "boolean" },
        "rejectionReason": { "type": "string" },
        "canViewSensisitve": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "phone", "image", "gender", "isApproved"]
    },
    "DeliveryPartnerProfile": {
      "title": "DeliveryPartnerProfile",
      "description": "A profile for a delivery partner.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "vehicleType": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["Online", "Offline", "On Trip", "Banned", "Approved", "Pending"] },
        "isOnline": { "type": "boolean" },
        "earnings": { "type": "number" },
        "pendingPayout": { "type": "number" },
        "rating": { "type": "number" },
        "trips": { "type": "number" },
        "cashInHand": { "type": "number" },
        "photo": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "status", "userId"]
    },
    "VendorProfile": {
      "title": "VendorProfile",
      "description": "A profile for a vendor.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessName": { "type": "string" },
        "ownerName": { "type": "string" },
        "phone": { "type": "string" },
        "service": { "type": "string" },
        "status": { "type": "string", "enum": ["Approved", "Pending", "Terminated"] },
        "isOnline": { "type": "boolean" },
        "revenue": { "type": "number" },
        "pendingPayout": { "type": "number" },
        "itemsCount": { "type": "number" },
        "rating": { "type": "number" },
        "photo": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "businessName", "phone", "status", "userId"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Preparing", "Ready", "PickedUp", "Delivered", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "paymentMethod": { "type": "string" },
        "deliveryType": { "type": "string" },
        "vendorId": { "type": "string" },
        "deliveryPartnerId": { "type": "string" }
      },
      "required": ["id", "userId", "totalAmount", "status", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A user task.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Completed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "status"]
    },
    "PartnerApplication": {
      "title": "PartnerApplication",
      "description": "A request for vendor or delivery partner status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["Vendor", "DeliveryPartner"] },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "businessName": { "type": "string" },
        "businessType": { "type": "string" },
        "location": { "type": "string" },
        "gstNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "fullName", "phone", "location", "status", "createdAt"]
    },
    "Property": {
      "title": "Property",
      "description": "A real estate property listing.",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerPhone": { "type": "string" },
        "title": { "type": "string" },
        "price": { "type": "number" },
        "type": { "type": "string" },
        "image": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "area": { "type": "string" },
            "city": { "type": "string" },
            "pincode": { "type": "string" },
            "fullAddress": { "type": "string" }
          }
        },
        "details": {
          "type": "object",
          "properties": {
            "sqft": { "type": "string" },
            "bedrooms": { "type": "string" },
            "furnished": { "type": "string" },
            "facing": { "type": "string" }
          }
        },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "title", "price", "isApproved"]
    },
    "MarriageInterest": {
      "title": "MarriageInterest",
      "description": "Interest expressed between marriage profiles.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromUserId": { "type": "string" },
        "fromProfileId": { "type": "string" },
        "toUserId": { "type": "string" },
        "toProfileId": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fromUserId", "toUserId", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "An application category.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "name", "icon"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global settings for the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "allowBankTransfer": { "type": "boolean" },
        "allowCashOnRegistration": { "type": "boolean" },
        "registrationFee": { "type": "number" },
        "upiId": { "type": "string" },
        "accountHolder": { "type": "string" }
      },
      "required": ["id"]
    },
    "SupportComplaint": {
      "title": "SupportComplaint",
      "description": "A customer complaint or support request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "orderId": { "type": "string" },
        "category": { "type": "string", "enum": ["Payment Issue", "Delivery Boy Behavior", "Order Issue", "Other"] },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "In Progress", "Resolved", "Closed"] },
        "adminAnswer": { "type": "string" },
        "branchId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "customerName", "category", "description", "status", "createdAt"]
    },
    "SOSAlert": {
      "title": "SOSAlert",
      "description": "Emergency SOS distress signal transmitted during a panic sequence.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "triggerType": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "exactTime": { "type": "string" },
        "exactDate": { "type": "string" },
        "isoTimestamp": { "type": "string" }
      },
      "required": ["id", "name", "phone", "latitude", "longitude", "exactTime"]
    },
    "OtpVerification": {
      "title": "OtpVerification",
      "description": "Transient OTP verification records.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "expiry": { "type": "number" },
        "phoneNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "verified": { "type": "boolean" }
      },
      "required": ["code", "phoneNumber"]
    }
  },
  "firestore": {
    "/otp_verifications/{phoneId}": {
      "schema": "OtpVerification",
      "description": "OTP verification tokens and states."
    },
    "/sos_alerts/{alertId}": {
      "schema": "SOSAlert",
      "description": "Real-time emergency SOS distress alerts with exact time and coordinates."
    },
    "/support_complaints/{complaintId}": {
      "schema": "SupportComplaint",
      "description": "Customer support complaints."
    },
    "/settings/{settingsId}": {
      "schema": "PlatformSettings",
      "description": "Global platform settings."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "System categories."
    },
    "/marriageProfiles/{profileId}": {
      "schema": "MarriageProfile",
      "description": "Marriage bureau profiles."
    },
    "/marriageInterests/{interestId}": {
      "schema": "MarriageInterest",
      "description": "Interests expressed in marriage bureau."
    },
    "/deliveryPartners/{partnerId}": {
      "schema": "DeliveryPartnerProfile",
      "description": "Delivery partner profiles."
    },
    "/vendors/{vendorId}": {
      "schema": "VendorProfile",
      "description": "Vendor profiles."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "General orders."
    },
    "/properties/{propertyId}": {
      "schema": "Property",
      "description": "Real estate listings."
    },
    "/partner_applications/{appId}": {
      "schema": "PartnerApplication",
      "description": "Requests for vendor or delivery partner status."
    },
    "/payouts/{payoutId}": {
      "schema": "object",
      "description": "Record of settled payouts."
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks."
    }
  }
}
